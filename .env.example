# Example environment variables for WealthShock
GEMINI_API_KEY=
PIXABAY_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# In GitHub Actions, GITHUB_TOKEN is supplied automatically by the workflow runtime.
# Use RENDER_API_KEY and RENDER_SERVICE_ID only in GitHub Actions or local auto-heal runs.
RENDER_API_KEY=
RENDER_SERVICE_ID=
